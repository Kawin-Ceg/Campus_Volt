# Copy to .env and adjust. The backend services read these from the environment;
# the frontend (Vite) reads the VITE_ values from this folder's .env file.

# PostgreSQL (one server, four databases - see database/create-databases.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Must be the same value for all four services, at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-of-32-or-more-chars
JWT_EXPIRATION_MINUTES=480

# First admin account, created by auth-service on startup if missing
ADMIN_EMAIL=admin@campusvolt.edu
ADMIN_PASSWORD=Admin@123

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Service-to-service URLs
FLEET_SERVICE_URL=http://localhost:8082
TRIP_SERVICE_URL=http://localhost:8083

# Frontend API URLs
VITE_AUTH_API_URL=http://localhost:8081
VITE_FLEET_API_URL=http://localhost:8082
VITE_TRIP_API_URL=http://localhost:8083
VITE_OCCUPANCY_API_URL=http://localhost:8084
